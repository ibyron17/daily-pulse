# Daily Pulse — GitLab CI/CD 스케줄 예시 (AI 요약 없는 폴백)
#
# 이 파일은 순수 CLI 파이프라인을 실행합니다 (python daily_pulse.py).
# AI 요약이 필요하면 Claude Code Skill을 사용하세요.
#
# 이 파일을 프로젝트의 .gitlab-ci.yml에 병합하거나,
# 혼재된 파이프라인 설정을 피하려면 별도 trigger로 구성하세요.
#
# 주의: 러너가 GitLab 서버에 네트워크로 접근할 수 있어야 합니다(사설망의 GitLab이면 그 망 안의 러너).

stages:
  - daily_pulse

daily_pulse:
  stage: daily_pulse
  image: python:3.10

  script:
    # 의존성 설치
    - pip install -e .

    # Daily Pulse 실행
    - python daily_pulse.py

  # 환경 변수는 GitLab UI에서 설정 (Settings → CI/CD → Variables)
  # Name: GITLAB_TOKEN
  # Value: glpat-xxxxxxxxxxxxxxxx
  # Protected: 체크 (선택사항)
  # Masked: 체크 (권장 — 로그에서 토큰값 마스킹)
  environment:
    name: daily_pulse

  artifacts:
    paths:
      - reports/
    expire_in: 90 days
    # 대시보드 HTML 파일을 아티팩트로 보존

  cache:
    paths:
      - .venv/
      - .cache/pip/

  # 스케줄: GitLab 웹 UI에서 설정
  # Settings → CI/CD → Schedules
  # Cron: 0 8 * * 1-5 (KST 08:00 평일)
  # Active: 체크
  only:
    - schedules

  # 태그: GitLab 서버에 접근할 수 있는 러너에 할당
  tags:
    - internal   # 실제 러너 태그로 바꾼다
    - docker

# === 수동 설정 (GitLab 웹 UI 대안) ===
#
# GitLab이 cron 스케줄을 UI로만 지원하지 않으려면,
# 대신 git CI 커밋으로 직접 정의하려면 아래 유사 형식을 사용할 수 있습니다
# (하지만 권장하지 않음 — UI가 더 간편함):
#
# schedule: "0 8 * * 1-5"

# === 다른 파이프라인과의 공존 ===
#
# 기존 .gitlab-ci.yml이 있으면:
#
# 1. 이 파일의 내용을 병합:
#    - stages에 daily_pulse 추가 (또는 기존 스테이지 뒤에 추가)
#    - daily_pulse job 정의 추가
#
# 2. only/except 검토:
#    - only.schedules를 추가해야 스케줄 작동 가능
#
# 3. 전체 파이프라인 테스트:
#    - Git에 푸시하면 CI 트리거되므로, 우선 로컬에서 테스트
#    - gitlab-runner local-shell-executor로 검증 (선택)

# === CI/CD 변수 설정 (GitLab 웹 UI) ===
#
# 1. 프로젝트 페이지 접속
# 2. Settings → CI/CD 클릭
# 3. Variables 섹션에서 "Add variable" 클릭
# 4. Name: GITLAB_TOKEN
# 5. Value: (발급받은 personal access token 붙여넣기)
# 6. Masked: 체크 (로그에서 토큰값이 마스킹됨)
# 7. Protected: 체크 (선택사항 — protected branch에서만 사용)
# 8. Save

# === 스케줄 설정 (GitLab 웹 UI) ===
#
# 1. 프로젝트 페이지 접속
# 2. Settings → CI/CD → Schedules 클릭
# 3. "New schedule" 버튼 클릭
# 4. Description: "Daily Pulse — 08:00 KST" (예)
# 5. Cron: 0 8 * * 1-5
#    (분 시 일 월 요일 형식. 1-5 = 월-금)
# 6. Timezone: Asia/Seoul
# 7. Target branch: main (또는 기본 브랜치)
# 8. Active: 체크
# 9. Save

# === 트러블슈팅 ===
#
# Q: 스케줄이 작동하지 않는다
# A: 1. Settings → CI/CD → Schedules에서 "Active" 체크 확인
#    2. 스케줄 시간이 UTC 기준인지 로컬 타임존인지 확인
#       (UI에서 Timezone 설정)
#    3. Target branch가 존재하는 브랜치인지 확인
#    4. CI/CD 변수(GITLAB_TOKEN)가 설정되었는지 확인
#
# Q: "Runner not found" 오류
# A: tags에서 지정한 러너가 온라인이고 GitLab 서버에 접근 가능한지 확인
#    Settings → CI/CD → Runners에서 온라인 상태 확인
#
# Q: GITLAB_TOKEN이 로그에 노출된다
# A: 1. CI/CD 변수 설정 시 "Masked" 체크
#    2. 로그 파일이 접근 제한되는지 확인

